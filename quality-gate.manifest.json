{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.18.0/schemas/schema.json",
  "services": [
    {
      "product": "Android-Mobile-Credential-Sharing",
      "component": "mobile-credential-sharing-android",
      "promotionType": "library",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [{ "name": "code style and linting" }],

          "file": ".github/workflows/pull-request.yml",
          "path": "$.jobs.linting"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "contract"
            }
          ],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.contract-debug-tests.steps[?@.name=='Run contract tests (debug)']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [{ "name": "code quality" }, { "name": "unit" }],

          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.unit_tests.steps[?@.name=='Run unit tests']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [{ "name": "integration" }],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.instrumentation_tests.steps[?@.name=='Run instrumentation tests']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            { "name": "code quality" },
            { "name": "unit test coverage" },
            { "name": "vulnerability detection" }
          ],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.sonar_scan.steps[?@.name=='Sonar scan']"
        },
        {
          "name": "Verify conventional commit standards",
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [{ "name": "code style and linting" }],
          "file": ".github/workflows/linting.yml",
          "path": "$.jobs.conventional_commits"
        },
        {
          "checks": [{ "name": "code style and linting" }],
          "phase": "pre-merge",
          "provider": "GitHub",
          "file": ".github/workflows/linting.yml",
          "path": "$.jobs.prose_linting"
        },
        {
          "checks": [{ "name": "code style and linting" }],
          "phase": "pre-merge",
          "provider": "GitHub",
          "file": ".github/workflows/linting.yml",
          "path": "$.jobs.android_linting"
        },
        {
          "checks": [{ "name": "code style and linting" }],
          "phase": "pre-merge",
          "provider": "GitHub",
          "file": ".github/workflows/linting.yml",
          "path": "$.jobs.kotlin_linting"
        },
        {
          "checks": [
            { "name": "unit" },
            { "name": "integration" },
            { "name": "unit test coverage" }
          ],
          "file": ".github/workflows/testing.yml",
          "name": "Instrumentation tests",
          "phase": "pre-merge",
          "provider": "GitHub"
        },
        {
          "checks": [],
          "file": ".github/workflows/bump-version.yml",
          "name": "Bump semantic version of the code base",
          "path": "$.jobs.bump-version",
          "phase": "pre-release",
          "provider": "GitHub"
        },
        {
          "checks": [],
          "file": ".github/workflows/publish-libraries.yml",
          "name": "Upload code base artefacts to GitHub packages",
          "path": "$.jobs.publish-libraries",
          "phase": "pre-release",
          "provider": "GitHub"
        },
        {
          "checks": [],
          "file": ".github/workflows/testing.yml",
          "name": "Upload test app artefacts to the Google Play Store",
          "path": "$.jobs.instrumentation_tests",
          "phase": "pre-release",
          "provider": "GitHub"
        },
        {
          "checks": [],
          "file": ".github/workflows/merge-to-main.yml",
          "name": "Publish Gradle dependency graph results to GitHub dependabot",
          "path": "$.jobs.dependency-graph",
          "phase": "pre-release",
          "provider": "GitHub"
        },
        {
          "phase": "pre-release",
          "provider": "GitHub",
          "checks": [{ "name": "code style and linting" }],

          "file": ".github/workflows/merge-to-main.yml",
          "path": "$.jobs.linting"
        },
        {
          "checks": [],
          "file": ".github/workflows/merge-to-main.yml",
          "name": "Uploads code base artefacts to GitHub packages / Google Play Store",
          "path": "$.jobs.publishing",
          "phase": "pre-release",
          "provider": "GitHub"
        },
        {
          "checks": [
            { "name": "code quality" },
            { "name": "contract" },
            { "name": "integration" },
            { "name": "unit" },
            { "name": "unit test coverage" }
          ],
          "file": ".github/workflows/merge-to-main.yml",
          "name": "Test code base",
          "path": "$.jobs.testing",
          "provider": "GitHub",
          "phase": "pre-release"
        }
      ]
    }
  ]
}
