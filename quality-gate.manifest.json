{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.17.0/schemas/schema.json",
  "services": [
    {
      "product": "Android-Mobile-Credential-Sharing",
      "component": "mobile-credential-sharing-android",
      "promotionType": "library",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/pull-request.yml",
          "path": "$.jobs.linting"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "contract"
            }
          ],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.contract-debug-tests.steps[?@.name=='Run contract tests (debug)']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.unit_tests.steps[?@.name=='Run unit tests']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration"
            }
          ],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.instrumentation_tests.steps[?@.name=='Run instrumentation tests']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.sonar_scan.steps[?@.name=='Sonar scan']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/linting.yml",
          "path": "$.jobs.conventional_commits"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/linting.yml",
          "path": "$.jobs.prose_linting"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/linting.yml",
          "path": "$.jobs.android_linting"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/linting.yml",
          "path": "$.jobs.kotlin_linting"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "contract"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.contract-debug-tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.unit_tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration"
            }
          ],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.instrumentation_tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/testing.yml",
          "path": "$.jobs.sonar_scan"
        },
        {
          "phase": "pre-release",
          "provider": "GitHub",
          "checks": [],
          "file": ".github/workflows/merge-to-main.yml",
          "path": "$.jobs.bump_and_publish"
        }
      ]
    }
  ]
}
