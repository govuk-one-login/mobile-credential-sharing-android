{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.11.0/schemas/schema.json",
  "services": [
    {
      "serviceTag": "mobile-credential-sharing-android",
      "promotionType": "library",
      "checks": [
        {
          "checkTypes": [
            "code style and linting"
          ],
          "config": {
            "file": ".github/workflows/pull-request.yml",
            "name": "Linting",
            "path": "$.jobs.linting"
          },
          "phase": "pre-merge",
          "provider": "GitHub"
        },
        {
          "checkTypes": [
            "code quality",
            "contract",
            "integration",
            "unit",
            "unit test coverage"
          ],
          "config": {
            "file": ".github/workflows/pull-request.yml",
            "name": "Test suites",
            "path": "$.jobs.testing"
          },
          "phase": "pre-merge",
          "provider": "GitHub"
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "config": {
            "file": ".github/workflows/linting.yml",
            "path": "$.jobs.conventional_commits"
          },
          "phase": "pre-merge",
          "provider": "GitHub"
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/linting.yml",
            "path": "$.jobs.prose_linting"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/linting.yml",
            "path": "$.jobs.android_linting"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/linting.yml",
            "path": "$.jobs.kotlin_linting"
          }
        },
        {
          "checkTypes": [
            "contract",
            "unit test coverage"
          ],
          "config": {
            "file": ".github/workflows/testing.yml",
            "name": "Contract (ISO-18013-6) tests",
            "path": "$.jobs.contract-debug-tests"
          },
          "phase": "pre-merge",
          "provider": "GitHub"
        },
        {
          "checkTypes": [
            "unit",
            "unit test coverage"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/testing.yml",
            "path": "$.jobs.unit_tests"
          }
        },
        {
          "checkTypes": [
            "unit",
            "integration",
            "unit test coverage"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/testing.yml",
            "path": "$.jobs.instrumentation_tests"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "unit test coverage",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/testing.yml",
            "path": "$.jobs.sonar_scan"
          }
        },
        {
          "checkTypes": [],
          "phase": "pre-release",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/merge-to-main.yml",
            "path": "$.jobs.bump_and_publish"
          }
        }
      ]
    }
  ]
}
